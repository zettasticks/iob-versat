// NOTE: Expr is a way of separating the expr like nodes (first,second) from the (next,children) type
table NodeTable(name,isExprType,constantOpCount){
  NIL                  0   0
  NOT                  1   1
  ADD                  1   2
  SUB                  1   2
  MUL                  1   2
  DIV                  1   2
  VAR                  0   0
  LITERAL              1   0
  FUNC_CALL            0   0
  AND                  1   2
  OR                   1   2
  XOR                  1   2
  RHL                  1   2
  RHR                  1   2
  SHL                  1   2
  SHR                  1   2
  RANGE                1   2
  EXPR                 0   0
  HIER_ACCESS          0   0
  RANGE_ACCESS         0   0
  DELAY_ACCESS         0   0
  PORT_ACCESS          0   0
  INPUT_DECL           0   0
  VAR_DECL             0   0
  MODULE_INPUTS        0   0
  MODIFIER_DEBUG       0   0
  MODIFIER_STATIC      0   0
  MODIFIER_SHARE       0   0
  MODIFIER_SIM         0   0
  MODIFIER_LIST        0   0
  ID                   0   0
  PARAM                0   0
  PARAM_LIST           0   0
  VARIABLE_DECL        0   0
  VAR_GROUP            0   0
  FOR_LOOP             0   0
  GEN_LOOP             0   0
  FUNCTION_CALL        0   0
  EQUALITY             0   0
  CONNECTION           0   0
  PARAM_DECL           0   0
  DECL_LIST            0   0
  CON_LIST             0   0
  FUNC_LIST            0   0
  MODULE_DECL          0   0
  FUNC_CONFIG          0   0
  FUNC_STATE           0   0
  FUNC_MEM             0   0
  FUNC_TYPE_BUFFER     0   0
  FUNC_TYPE_DYN        0   0
  FUNC_TYPE_FIXED      0   0
  FUNC_TYPE_NONE       0   0
  STMT                 0   0
  STMT_LIST            0   0
}

enum SP_Type{ @(for a NodeTable) $$ SP_Type_@(a.name) $$}

map SP_Type_Name(SP_Type,String){ @(for a NodeTable) $$ SP_Type_@(a.name) -> "@(a.name)" $$ }
map SP_Type_IsExpr(SP_Type,bool){ @(for a NodeTable) $$ SP_Type_@(a.name) -> @(a.isExprType) $$ }
map SP_Type_OpCount(SP_Type,int){ @(for a NodeTable) $$ SP_Type_@(a.name) -> @(a.constantOpCount) $$ }
